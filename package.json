{
  "name": "sitebuilder-x-ultra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:external": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @sitebuilder/server\" \"npm run dev -w @sitebuilder/web\"",
    "db:local": "node scripts/postgres.mjs",
    "db:generate": "prisma generate --schema apps/server/prisma/schema.prisma",
    "db:push": "prisma db push --schema apps/server/prisma/schema.prisma --skip-generate",
    "build": "npm run db:generate && npm run build -w @sitebuilder/web && npm run build -w @sitebuilder/server",
    "build:vercel": "npm run build:vercel -w @sitebuilder/server",
    "start": "npm run db:push && node apps/server/dist/index.js",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/server && tsc --noEmit -p apps/web",
    "test": "tsx --test packages/shared/src/*.test.ts apps/server/src/*.test.ts"
  },
  "dependencies": {
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
